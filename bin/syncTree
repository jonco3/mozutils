#!/usr/bin/env python3

# Sync a tree from a remote one by fetching a diff of outgoing changes
# and applying it locally.

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile

sys.path.append(os.path.join(os.path.dirname(__file__), '..', 'lib'))
from mozutils import *

parser = argparse.ArgumentParser(description = 'Sync with remote tree')
parser.add_argument('--print-changes', metavar="TREE",
                    help="Print outgoing changes as a diff (used internally on server)")
args = parser.parse_args()

def print_changes():
    if subprocess.run('jj root', shell=True, capture_output=True).returncode != 0:
        sys.exit("Not in a jj repo")
    base_commit = get_base_commit()
    diff = get_diff(base_commit)
    print(json.dumps([base_commit, diff]), flush=True)

def get_base_commit():
    stdout = run_or_exit('jj log -r "latest(immutable() & ancestors(@))" --no-graph -T "commit_id"')
    commit = stdout.strip()
    assert re.match(r'[0-9a-f]{40}$', commit)
    return commit

def get_diff(base_commit):
    return run_or_exit(f'jj diff --git --from {base_commit} --to @')

def sync_changes():
    if subprocess.run('git rev-parse --git-dir', shell=True, capture_output=True).returncode != 0:
        sys.exit("Not in a git repo")
    client = os.environ['SSH_CLIENT'].split()[0]
    if not client:
        sys.exit("SSH_CLIENT not set, can't identify server")
    assert re.match(r'(\d+\.){3}\d+$', client)

    tree = os.path.basename(os.getcwd())

    print(f"Fetching changes for '{tree}' from {client}")
    response = run_or_exit(f'ssh {client} "syncTree --print-changes {tree}"')
    [base_commit, diff] = json.loads(response)
    linecount = len(diff.splitlines())
    print(f"Fetched {linecount} line diff against commit {base_commit[:12]}")

    file = tempfile.NamedTemporaryFile(mode='wb', suffix='.patch', delete=False)
    file.write(diff.encode())
    file.close()
    path = file.name

    p = subprocess.run(f'git cat-file -e {base_commit}', shell=True)
    if p.returncode != 0:
        sys.exit(f"Base commit {base_commit[:12]} not found in remote repo — fetch from upstream first")

    print("Resetting to base commit")
    run_or_exit(f'git reset --hard {base_commit}')
    run_or_exit('git clean -fd')

    if diff.strip():
        print("Applying diff")
        run_or_exit(f'git apply {path}')

    os.remove(path)
    print("done.")

def run_or_exit(command):
    p = subprocess.run(command, shell=True, capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f'Failed to run {command}: {p.stderr}')
    return p.stdout

if args.print_changes:
    path = "~/firefox/" + args.print_changes
    path = os.path.expanduser(path)
    if not os.path.isdir(path):
        sys.exit("Tree not found: " + path)
    os.chdir(path)

    print_changes()
else:
    chdir_to_source_root()
    sync_changes()
