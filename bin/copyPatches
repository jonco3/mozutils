#!/usr/bin/env python3

# Copy jj patches from local repos to a shared dropbox

import argparse
import os
import os.path
import re
import subprocess
import sys

SOURCE = os.path.expanduser('~/firefox')
DEST = os.path.expanduser('~/shared/patches')
HOSTALIAS = os.path.expanduser('~/.hostalias')

REVSET = 'mine() & mutable()'
LOGFILE = 'jj-log.txt'

# Records, for each patch, the information needed to reconstruct the stack
# from the patch files alone: its change id (matching the patch filename),
# its commit id, and its parents' change and commit ids.
LOG_TEMPLATE = (
    '"change_id: " ++ change_id.short() ++ "\\n"'
    ' ++ "commit_id: " ++ commit_id ++ "\\n"'
    ' ++ "parents: " ++ parents.map('
    '|c| c.change_id().short() ++ " (" ++ c.commit_id() ++ ")"'
    ').join(", ") ++ "\\n\\n"'
    ' ++ description ++ "\\n"'
    ' ++ "----------------------------------------\\n"'
)

parser = argparse.ArgumentParser(description='Copy jj patches to shared dropbox')
parser.add_argument('-v', '--verbose', action='store_true', help='Print progress')
parser.add_argument('-n', '--dry-run', action='store_true',
                    help="Show what would be done without changing anything")
args = parser.parse_args()

verbose = args.verbose or args.dry_run

if not os.path.isdir(SOURCE):
    sys.exit("Can't find source dir: " + SOURCE)

if not os.path.isdir(DEST):
    sys.exit("Can't find dest dir: " + DEST)

if not os.path.isfile(HOSTALIAS):
    sys.exit("Can't find host alias in: " + HOSTALIAS)

with open(HOSTALIAS) as f:
    host = f.read().strip()

if verbose:
    print("copyPatches %s -> %s/%s" % (SOURCE, DEST, host))


def slugify(text):
    slug = text.lower()
    slug = re.sub(r'[^a-z0-9]+', '-', slug)
    slug = slug.strip('-')
    slug = slug[:60]
    slug = slug.rstrip('-')
    return slug or 'no-description'


def jj(*args, cwd):
    return subprocess.run(['jj', *args], cwd=cwd, check=True,
                           capture_output=True, text=True).stdout


for name in sorted(os.listdir(SOURCE)):
    repoDir = os.path.join(SOURCE, name)
    if not os.path.isdir(os.path.join(repoDir, '.jj')):
        continue

    if verbose:
        print("  repo %s" % name)

    backup = os.path.join(DEST, host, name)
    if not args.dry_run:
        os.makedirs(backup, exist_ok=True)
        log = jj('log', '-r', REVSET, '--no-graph', '-T', LOG_TEMPLATE, cwd=repoDir)
        with open(os.path.join(backup, LOGFILE), 'w') as f:
            f.write(log)

    expected = {LOGFILE}

    template = 'change_id.short() ++ "\\t" ++ description.first_line() ++ "\\n"'
    log = jj('log', '-r', REVSET, '--no-graph', '-T', template, cwd=repoDir)
    for line in log.splitlines():
        id, desc = line.split('\t', 1)
        slug = slugify(desc)
        file = "%s-%s.patch" % (id, slug)
        expected.add(file)
        patch = jj('show', '--ignore-working-copy', '--git', '-r', id, cwd=repoDir)
        dest_file = os.path.join(backup, file)
        if os.path.isfile(dest_file):
            with open(dest_file) as f:
                existing = f.read()
            if existing == patch:
                if verbose:
                    print("    unchanged %s" % file)
                continue
        if verbose:
            print("    writing %s" % file)
        if not args.dry_run:
            with open(dest_file, 'w') as f:
                f.write(patch)

    if os.path.isdir(backup):
        for file in os.listdir(backup):
            if file not in expected:
                if verbose:
                    print("    deleting %s" % file)
                if not args.dry_run:
                    os.remove(os.path.join(backup, file))
